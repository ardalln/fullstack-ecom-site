APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop?sslmode=disable

# Required: generate a unique secret with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=shop-api
JWT_ACCESS_TTL=24h

# One-time password (OTP) settings for phone-based login/registration.
# The code is "sent" by printing it to this server's own terminal (see
# internal/sms) until a real SMS provider is wired in.
OTP_TTL=2m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# Optional: an admin user is created on startup if it does not exist yet.
# Use the Iranian mobile format: 09xxxxxxxxx
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=فروشگاه
ADMIN_PHONE=
